# Local Docker Compose demo configuration. Do not reuse these credentials in a
# production or internet-accessible deployment.
NODE_ENV=development
POSTGRES_DB=scholarshelf
POSTGRES_USER=scholarshelf
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql://scholarshelf:local_dev_password@postgres:5432/scholarshelf?schema=public

WEB_URL=http://localhost:3000
API_URL=http://api:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=4000

JWT_ACCESS_SECRET=local_access_secret_change_me_32_chars
JWT_REFRESH_SECRET=local_refresh_secret_change_me_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TOKEN_PEPPER=local_token_pepper_change_me

INSTITUTION_NAME=Northbridge University
INSTITUTION_EMAIL_DOMAIN=example.edu

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=library-resources
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

ML_SERVICE_URL=http://recommendations:8000
ML_INTERNAL_TOKEN=local_ml_internal_token_change_me

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScholarShelf <library@example.edu>
MAIL_LOG_LINKS=true

# Created by the seed command. Change before exposing the stack to a network.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_DEMO_DATA=true
