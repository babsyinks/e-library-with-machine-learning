NODE_ENV=production
POSTGRES_DB=scholarshelf
POSTGRES_USER=scholarshelf
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://scholarshelf:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/scholarshelf?schema=public

DOMAIN=library.example.edu
WEB_URL=https://library.example.edu
API_URL=http://api:4000/api
NEXT_PUBLIC_API_URL=https://library.example.edu/api
PORT=4000

JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHAR_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TOKEN_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET

INSTITUTION_NAME=Example University
INSTITUTION_EMAIL_DOMAIN=example.edu

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.library.example.edu
S3_REGION=us-east-1
S3_BUCKET=library-resources
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_REQUIRED=true

ML_SERVICE_URL=http://recommendations:8000
ML_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_TOKEN

SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=library@example.edu
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=ScholarShelf <library@example.edu>
MAIL_LOG_LINKS=false

SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=REPLACE_BEFORE_FIRST_DEPLOYMENT
SEED_DEMO_DATA=false
