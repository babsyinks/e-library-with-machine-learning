{
  "name": "scholarshelf",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @scholarshelf/api --filter @scholarshelf/web dev",
    "build": "pnpm --filter @scholarshelf/api build && pnpm --filter @scholarshelf/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @scholarshelf/api test",
    "test:ml": "python -m pytest services/recommendations/tests -q",
    "db:generate": "pnpm --filter @scholarshelf/api prisma:generate",
    "db:migrate": "pnpm --filter @scholarshelf/api prisma:migrate",
    "db:seed": "pnpm --filter @scholarshelf/api prisma:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
